<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <requires lib="libadwaita" version="1.0"/>
  <requires lib="gio" version="2.32"/>

  <template class="FlChannelList" parent="GtkBox">
    <property name="hexpand">False</property>
    <property name="vexpand">True</property>
    <property name="orientation">vertical</property>

    <!-- Offline Indicator -->
    <child>
      <object class="AdwBanner">
        <property name="title" translatable="yes">Offline</property>
        <binding name="revealed">
          <closure function="not" type="gboolean">
            <lookup name="network-available" type="GNetworkMonitor">
              <closure function="network_monitor" type="GNetworkMonitor"/>
            </lookup>
          </closure>
        </binding>
      </object>
    </child>

    <child>
      <object class="GtkSearchBar">
        <property name="search-mode-enabled" bind-source="FlChannelList" bind-property="search-enabled"/>
        <child>
          <object class="GtkSearchEntry" id="search_entry">
            <property name="tooltip-text" translatable="yes">Search</property>
            <accessibility>
              <property name="label" translatable="yes" context="accessibility">Search</property>
            </accessibility>

            <signal name="search-changed" handler="search_changed" swapped="yes"/>
            <signal name="stop-search" handler="search_stopped" swapped="yes"/>
            <signal name="activate" handler="search_activate" swapped="yes"/>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="GtkScrolledWindow" id="scrolled_window">
        <property name="hscrollbar-policy">never</property>
        <binding name="visible">
          <closure function="not" type="gboolean">
            <closure function="uint_equal" type="gboolean">
              <lookup name="n-items" type="GtkNoSelection">
                <lookup name="model">
                  list
                </lookup>
              </lookup>
              <constant type="guint">0</constant>
            </closure>
          </closure>
        </binding>

        <property name="child">
          <object class="GtkListView" id="list">
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <style>
              <class name="navigation-sidebar"/>
            </style>
          </object>
        </property>
      </object>
    </child>

    <child>
      <object class="AdwStatusPage">
        <property name="title">No Conversations</property>
        <property name="description">Add a conversation</property>
        <property name="icon-name">document-edit-symbolic</property>
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>

        <binding name="visible">
          <closure function="uint_equal" type="gboolean">
            <lookup name="n-items" type="GtkNoSelection">
              <lookup name="model">
                list
              </lookup>
            </lookup>
            <constant type="guint">0</constant>
          </closure>
        </binding>
      </object>
    </child>
  </template>
</interface>
