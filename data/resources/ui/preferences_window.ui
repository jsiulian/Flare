<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <requires lib="libadwaita" version="1.0"/>

  <template class="FlPreferencesWindow" parent="AdwPreferencesWindow">
    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">General</property>
        <property name="icon-name">preferences-system-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup" id="group_programs">
            <property name="title" translatable="yes">Linking</property>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Device Name</property>
                <property name="subtitle" translatable="yes">The device will need to be relinked to take effect.</property>
                <child>
                  <object class="GtkEntry" id="entry_device_name">
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
