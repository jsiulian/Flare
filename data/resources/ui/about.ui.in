<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="AdwAboutWindow" id="about">
    <property name="application-icon">icon</property>
    <property name="application-name">Flare</property>
    <property name="version">@VERSION@</property>
    <property name="comments">A unofficial Signal GTK client.</property>

    <property name="issue-url">https://gitlab.com/Schmiddiii/flare/-/issues</property>
    <property name="support-url">https://matrix.to/#/%23flare-signal:matrix.org</property>
    <property name="website">https://gitlab.com/Schmiddiii/flare</property>

    <property name="developer-name">Julian Schmidhuber</property>
    <property name="translator-credits" translatable="yes">translator-credits</property>
    <property name="artists">David Lapshin &lt;ddaudix@gmail.com&gt;</property>

    <property name="copyright">© 2022 Julian Schmidhuber</property>
    <property name="license-type">GTK_LICENSE_AGPL_3_0_ONLY</property>

    <property name="release-notes">
&lt;p&gt;Added&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Immediately sync contacts after linking, without application restart required.&lt;/li&gt;
&lt;li&gt;Show UUID for unknown contacts (without name, phone numbers) instead of empty string.&lt;/li&gt;
&lt;li&gt;Notification support.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Changed&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Many UI updates.&lt;/li&gt;
&lt;li&gt;Use new libadwaita widgets (about dialog, message dialog, entry row).&lt;/li&gt;
&lt;li&gt;New message storage backend.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Fixed&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Wrongly associated stored messages from other devices.&lt;/li&gt;
&lt;li&gt;Possibly fixed libsecret-related issues.&lt;/li&gt;
&lt;li&gt;(Upstream) Fixed duplicate messages to other third-party Signal clients.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;BREAKING&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Due to changes in the storage backend, your previously stored messages will be lost.&lt;/li&gt;
&lt;/ul&gt;
    </property>
  </object>
</interface>
