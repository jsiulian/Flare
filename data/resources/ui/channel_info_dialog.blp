using Gtk 4.0;
using Adw 1;

template $FlChannelInfoDialog: Adw.Dialog {
  can-focus: true;
  content-height: 600;
  content-width: 450;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
    }


    Adw.Clamp {
      orientation: horizontal;
      tightening-threshold: 360;
      maximum-size: 450;

      Gtk.ScrolledWindow {
        hscrollbar-policy: never;

        Box {
          spacing: 5;
          margin-start: 12;
          margin-end: 12;
          margin-top: 12;
          margin-bottom: 12;
          orientation: vertical;

          Adw.Avatar avatar {
            icon-name: "user-bookmarks-symbolic";
            size: 120;
          }

          Gtk.Label {
            styles [ "title-1" ]
            label: bind template.channel as <$FlChannel>.title;
            lines: 2;
            wrap: true;
            ellipsize: end;
            margin-bottom: 24;
          }

          Adw.PreferencesGroup group_phone_description {
            margin-bottom: 18;
            Adw.ActionRow row_phone {
              styles ["property"]

              title: _("Phone Number");

              [suffix]
              Gtk.Button {
                styles ["flat"]
                tooltip-text: "Open phone number";
                icon-name: "call-start-symbolic";
                valign: center;

                clicked => $open_phone_number() swapped;
              }
            }

            Adw.ExpanderRow row_description {
              styles ["property"]

              title: _("Description");
            }
          }

          Adw.PreferencesGroup {
            margin-bottom: 18;

            Adw.ActionRow row_disappearing {
              styles ["property"]

              title: _("Disappearing Messages");
              [suffix]
              Gtk.Image {
                icon-name: "appointment-missed-symbolic";
              }
            }
          }

          Gtk.Grid grid_buttons {
            row-homogeneous: true;
            column-homogeneous: true;
            row-spacing: 6;
            column-spacing: 6;
          }
        }
      }
    }
  }
}

// Session Reset
Button button_reset_session {
  styles [ "card", "image-text-button" ]
  accessibility {
    label: C_("accessibility", "Reset Session");
  }

  clicked => $reset_session() swapped;

  child: Gtk.Box {
    margin-top: 6;
    margin-bottom: 6;
    margin-start: 6;
    margin-end: 6;
    spacing: 6;
    orientation: vertical;

    Gtk.Image {
      icon-name: "view-refresh-symbolic";
    }

    Gtk.Label {
      label: _("Reset Session");
    }
  };
}


// Clear messages
Button button_clear_messages {
  styles [ "card", "image-text-button" ]
  accessibility {
    label: C_("accessibility", "Clear Messages");
  }

  // Note: This uses the fact that the channel in `channel_messages` must be the same as in the info dialog as the info dialog can only be opened from there and the info dialog prevents any further interaction with the rest of the window.
  action-name: "win.channel-clear-messages";

  child: Gtk.Box {
    styles [ "error" ]

    margin-top: 6;
    margin-bottom: 6;
    margin-start: 6;
    margin-end: 6;
    spacing: 6;
    orientation: vertical;

    Gtk.Image {
      icon-name: "user-trash-symbolic";
    }

    Gtk.Label {
      label: _("Clear Messages");
    }
  };
}

