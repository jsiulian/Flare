using Gtk 4.0;
using Adw 1;

Adw.AboutDialog about {
  application-icon: "icon";
  application-name: "Flare";
  version: "@VERSION@";
  comments: "Chat with your friends on Signal";
  issue-url: "https://gitlab.com/schmiddi-on-mobile/flare/-/issues";
  support-url: "https://matrix.to/#/%23flare-signal:matrix.org";
  website: "https://mobile.schmidhuberj.de/flare";
  developer-name: "Julian Schmidhuber";
  translator-credits: _("translator-credits");
  // TODO: string[] is not supported by Blueprint, so artists need to be hardcoded
  copyright: "© 2022 Julian Schmidhuber";
  license-type: agpl_3_0_only;
  release-notes: "<p>HOTFIX</p> <ul> <li>Linking the device being broken (fixed upstream).</li> </ul> <p>Added</p> <ul> <li>Environmental variable to enable primary device mode option.</li> <li>Linked devices window on primary device mode.</li> </ul> <p>Fixes</p> <ul> <li>No notifications being sent when Flare is in the background for the last active channel.</li> <li>Fix not working on systems without login1 D-Bus interface.</li> <li>Primary device mode not working.</li> </ul>";
}
