using Gtk 4.0;
using Adw 1;

Adw.AboutWindow about {
  application-icon: "icon";
  application-name: "Flare";
  version: "@VERSION@";
  comments: "An unofficial Signal GTK client.";
  issue-url: "https://gitlab.com/Schmiddiii/flare/-/issues";
  support-url: "https://matrix.to/#/%23flare-signal:matrix.org";
  website: "https://gitlab.com/Schmiddiii/flare";
  developer-name: "Julian Schmidhuber";
  translator-credits: _("translator-credits");
  // TODO: string[] is not supported by Blueprint, so artists need to be hardcoded
  copyright: "© 2022 Julian Schmidhuber";
  license-type: agpl_3_0_only;
  release-notes: "<p>Changed</p>\n <ul>\n <li>Added support for voice messages/audio files.</li>\n <li>Ported the ui to Blueprint.</li>\n <li>New UI improvements to the feed list. This also now respects the accent colors set in GNOME.</li>\n <li>Reworked the popover menu for messages.</li>\n <li>Updated to GTK 4.10 with many UI improvements and minor fixes.</li>\n <li>Message popups are now opened with right-click or long-press (touch only).</li>\n </ul>\n <p>Fixed</p>\n <ul>\n <li>Issue where special characters in replied messages were displayed incorrectly.</li>\n <li>Attachments with very long names not being ellipsized.</li>\n <li>Messages with only attachment not persisting reactions.</li>\n </ul>\n";
}
