using Gtk 4.0;
using Adw 1;

Adw.AboutDialog about {
  application-icon: "icon";
  application-name: "Flare";
  version: "@VERSION@";
  comments: "Chat with your friends on Signal";
  issue-url: "https://gitlab.com/schmiddi-on-mobile/flare/-/issues";
  support-url: "https://matrix.to/#/%23flare-signal:matrix.org";
  website: "https://mobile.schmidhuberj.de/flare";
  developer-name: "Julian Schmidhuber";
  translator-credits: _("translator-credits");
  // TODO: string[] is not supported by Blueprint, so artists need to be hardcoded
  copyright: "© 2022 Julian Schmidhuber";
  license-type: agpl_3_0_only;
  release-notes: "<p>Changed</p> <ul> <li>Don't focus a few buttons when clicked, in order to keep on-screen keyboard open.</li> <li>Add counts to reaction emojis.</li> <li>Changed default reaction emoji list to match the one from Signal.</li> </ul> <p>Chores</p> <ul> <li>Updates to the backend, which should fix a few issues with Signal.</li> </ul>";
}
