using Gtk 4.0;
using Adw 1;

template $FlChannelItem: Box {
  accessibility {
    labelled-by: label-name;
  }

  margin-bottom: 6;
  margin-top: 6;
  hexpand: false;
  hexpand-set: true;
  // Avatar
  Adw.Avatar {
    text: bind template.channel as <$FlChannel>.title;
    custom-image: bind template.channel as <$FlChannel>.avatar;
    icon-name: "user-bookmarks-symbolic";
    show-initials: bind $not(template.channel as <$FlChannel>.is-self) as <bool>;
    size: 44;
  }

  Box {
    orientation: vertical;
    margin-start: 12;

    Box {
      // Channel name
      Label label-name {
        styles [
          "heading",
        ]

        label: bind template.channel as <$FlChannel>.title;
        halign: start;
        hexpand: true;
        ellipsize: end;
      }

      // Timestamp
      Label {
        styles [
          "dim-label",
          "caption",
          "numeric",
        ]

        label: bind $format_timestamp(template.channel as <$FlChannel>.last-message as <$FlMessage>.timestamp) as <string>;
        justify: right;
        vexpand: false;
        valign: start;
        hexpand: false;
        halign: end;
      }
    }

    Label label_last_message {
      halign: start;
      height-request: 36;
      xalign: 0;
      yalign: 0;
      wrap: true;
      ellipsize: end;
      lines: 2;
      use-markup: true;
      wrap-mode: word_char;
      natural-wrap-mode: none;
      label: bind $format_last_message(template.channel as <$FlChannel>.last-message as <$FlTextMessage>, template.channel as <$FlChannel>.is-typing as <bool>, template.channel as <$FlChannel>.draft as <string>) as <string>;

      styles [
        "subtitle",
      ]
    }
  }
}
