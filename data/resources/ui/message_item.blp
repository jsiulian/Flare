using Gtk 4.0;
using Adw 1;

template $FlMessageItem : Box {
  styles [
    "message-item",
  ]

  spacing: 12;
  visible: bind $not(template.message as <$FlTextMessage>.is-deleted) as <bool>;

  // Avatar (Not self)
  Adw.Avatar avatar {
    styles [
      "avatar-other",
    ]
    text: bind template.message as <$FlTextMessage>.sender as <$FlContact>.title;
    show-initials: true;
    valign: start;
    size: 32;
  }

  Box {
    orientation: vertical;

    Box message_box {
      orientation: vertical;
      spacing: 2;

      styles [
        "message-bubble",
      ]

      // Header
      Box header {
        orientation: horizontal;

        // Name
        Label {
          styles [
            "heading",
          ]

          label: bind template.message as <$FlTextMessage>.sender as <$FlContact>.title;
          hexpand: true;
          halign: start;
          ellipsize: end;
          margin-end: 15;
        }
      }

      // Quote
      Box quote {
        styles [
          "quote",
        ]

        visible: bind $is_some(template.message as <$FlTextMessage>.quote) as <bool>;
        Box {
          orientation: vertical;

          Label {
            styles [
              "heading",
            ]

            label: bind template.message as <$FlTextMessage>.quote as <$FlTextMessage>.sender as <$FlContact>.title;
            hexpand: true;
            halign: start;
          }

          Label {
            wrap: true;
            xalign: 0;
            wrap-mode: word_char;
            justify: left;
            vexpand: false;
            valign: start;
            hexpand: true;
            halign: start;
            use-markup: true;

            label: bind $markup_urls(template.message as <$FlTextMessage>.quote as <$FlTextMessage>.body) as <string>;
            attributes: bind template.message as <$FlTextMessage>.message-attributes;
          }
        }
      }

      // Attachments
      Box box_attachments {
        orientation: vertical;
        hexpand: true;
      }

      // Message Box
      Box message-box {
        orientation: vertical;

        Label label_message {
          wrap: true;
          xalign: 0;
          wrap-mode: word_char;
          justify: left;
          vexpand: false;
          valign: start;
          hexpand: true;
          halign: start;
          use-markup: true;

          label: bind $markup_urls(template.message as <$FlTextMessage>.body) as <string>;
          attributes: bind template.message as <$FlTextMessage>.message-attributes;
          visible: bind $not_empty(template.message as <$FlTextMessage>.body) as <bool>;
        }

        // Timestamp label
        Label {
          styles [
            "dim-label",
            "caption",
            "timestamp",
          ]

          label: bind $format_timestamp(template.message as <$FlTextMessage>.timestamp) as <string>;
          justify: right;
          vexpand: true;
          valign: end;
          hexpand: true;
          halign: end;
        }
      }

      // Pop-Down
      PopoverMenu msg_menu {
        menu-model: message-menu;
      }

      EmojiChooser emoji_chooser {
        emoji-picked => $handle_react() swapped;
      }
    }

    // Reactions
    Label reactions {
      styles [
        "reaction",
      ]

      label: bind template.message as <$FlTextMessage>.reactions;
      visible: bind template.has-reaction;
      wrap-mode: word;
      justify: left;
      vexpand: false;
      valign: start;
      hexpand: true;
      halign: start;
    }
  }
}

menu message-menu {
  section {
    display-hint: "horizontal-buttons";

    item {
      label: _("Reply");
      action: "msg.reply";
      verb-icon: "mail-reply-sender-symbolic";
      icon: "mail-reply-sender-symbolic";
    }

    item {
      label: _("React");
      action: "msg.react";
      verb-icon: "face-smile-symbolic";
      icon: "face-smile-symbolic";
    }

    item {
      label: _("Delete");
      action: "msg.delete";
      verb-icon: "user-trash-symbolic";
      icon: "user-trash-symbolic";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Copy");
      action: "msg.copy";
      verb-icon: "edit-copy-symbolic";
      icon: "edit-copy-symbolic";
    }
  }
}
