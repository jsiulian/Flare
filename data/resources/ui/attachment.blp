using Gtk 4.0;
using Adw 1;

template $FlAttachmentBase {
  layout-manager: BinLayout {};

  GestureClick click_gesture {
    button: 3;
    exclusive: true;
    pressed => $pressed() swapped;
  }

  GestureLongPress long_press_gesture {
    touch-only: true;
    exclusive: true;
    pressed => $pressed() swapped;
  }
}
