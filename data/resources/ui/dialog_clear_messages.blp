using Gtk 4.0;
using Adw 1;

Adw.MessageDialog dialog {
  heading: _("Clear messages");
  body: _("This will clear all locally stored messages. This will also close the application.");
  default-response: "cancel";
  close-response: "cancel";

  responses [
    cancel: _("Cancel"),
    clear: _("Clear") destructive,
  ]
}
