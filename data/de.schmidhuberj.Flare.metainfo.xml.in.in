  <requires>
    <internet>first-run</internet>
    <display_length compare="ge" side="shortest">300</display_length>
    <display_length compare="ge" side="longest">360</display_length>
  </requires>
  <recommends>
    <internet>always</internet>
  </recommends>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <branding>
    <color type="primary" scheme_preference="light">#ffa348</color>
    <color type="primary" scheme_preference="dark">#154b8e</color>
  </branding>
