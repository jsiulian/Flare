<Project xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:foaf="http://xmlns.com/foaf/0.1/"
         xmlns:gnome="http://api.gnome.org/doap-extensions#"
         xmlns="http://usefulinc.com/ns/doap#">

  <name xml:lang="en">Flare</name>
  <shortdesc xml:lang="en">Chat with your friends on Signal</shortdesc>
  <homepage rdf:resource="https://apps.gnome.org" />
  <bug-database rdf:resource="https://gitlab.com/schmiddi-on-mobile/flare/-/issues"/>
  <programming-language>Rust</programming-language>
  <platform>GTK 4</platform>
  <platform>Libadwaita</platform>

  <maintainer>
    <foaf:Person>
      <foaf:name>Julian Schmidhuber</foaf:name>
      <foaf:mbox rdf:resource="mailto:mobile@schmidhuberj.de" />
      <foaf:account>
        <foaf:OnlineAccount>
          <foaf:accountServiceHomepage rdf:resource="https://gitlab.com/"/>
          <foaf:accountName>Schmiddiii</foaf:accountName>
        </foaf:OnlineAccount>
      </foaf:account>
    </foaf:Person>
  </maintainer>
</Project>
