msgstr ""

#: data/resources/ui/window.ui:112
msgid "About"
msgstr "Über"

#: src/backend/channel.rs:296
msgid "Note to self"
msgstr "Notiz an mich"

#: src/backend/manager.rs:173
msgid "You"
msgstr "Du"

#: src/error.rs:74
msgid "I/O Error."
msgstr "I/O Fehler."

#: src/error.rs:79
msgid "There does not seem to be a connection to the internet available."
msgstr "Es scheint keine Internetverbindung vorhanden zu sein."

#: src/error.rs:84
msgid "The communication with Libsecret failed."
msgstr "Kommunikation mit Libsecret ist fehlgeschlagen."

#: src/error.rs:89
msgid ""
"The backend database failed. Please restart the application or delete the "
"database and relink the application."
msgstr ""
"Die Datenbank hatte einen Fehler. Bitte starten Sie die Applikation neu "
"oderlöschen Sie die Datenbank und verbinden Sie die Applikation erneut."

#: src/error.rs:94
msgid ""
"You do not seem to be authorized with Signal. Please delete the database and "
"relink the application."
msgstr ""
"Sie scheinen nicht mehr von Signal authorisiert zu sein. Bitte löschen Sie "
"die Datenbank und verbinden Sie die Applikation erneut."

#: src/error.rs:99
msgid "Sending a message failed."
msgstr "Konnte eine Nachricht nicht senden."

#: src/error.rs:104
msgid "Receiving a message failed."
msgstr "Konnte eine Nachricht nicht empfangen."

#: src/error.rs:109
msgid ""
"Something unexpected happened with the signal backend. Please retry later."
msgstr ""
"Etwas unerwartetes passierte mit Signal. Bitte versuchen Sie es später "
"erneut."

#: src/error.rs:114
msgid "The application seems to be misconfigured."
msgstr "Die Applikation scheint falsch konfiguriert zu sein."

#: src/error.rs:124
msgid "Please check your internet connection."
msgstr "Bitte prüfe deine Internetverbindung."

#: src/error.rs:128
msgid "Please delete the database and relink the device."
msgstr ""
"Bitte löschen Sie die Datenbank und verknüpfen Sie die Applikation erneut."

#: src/error.rs:135
msgid "The database path at {} is no folder."
msgstr "Der Datenbank Pfad bei {} ist kein Ordner."

#: src/gui/window.rs:73
msgid ""
"This will unlink this device and remove all locally saved data. This will "
"also close the application such that it can be relinked when opening it "
"again."
msgstr ""

#: src/gui/window.rs:75
msgid "Are you sure?"
msgstr ""

