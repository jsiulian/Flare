#: data/resources/ui/dialog_clear_messages.ui:5
msgid ""
"This will clear all locally stored messages. This will also close the "
"application."
msgstr ""
"Dies wird alle auf dem Gerät vorhandenen Nachrichten löschen und das Program "
"schließen."

