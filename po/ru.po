#: data/resources/ui/channel_messages.ui:102
msgid "Message"
msgstr "Сообщение"

#: data/resources/ui/error_dialog.ui:8
msgid "Error"
msgstr "Ошибка"

#: data/resources/ui/error_dialog.ui:14
msgid "Close"
msgstr "Закрыть"

#: data/resources/ui/error_dialog.ui:59
msgid "Please consider reporting this error."
msgstr "Пожалуйста, сообщите об этой ошибке."

#: data/resources/ui/link_window.ui:8
msgid "Link Device"
msgstr "Привязать устройство"

#: data/resources/ui/link_window.ui:16
msgid "Cancel"
msgstr "Отмена"

#: data/resources/ui/link_window.ui:25
msgid "Please scan this QR code with your primary device"
msgstr "Пожалуйста, отсканируйте этот QR-код на основном устройстве."

#: data/resources/ui/link_window.ui:34
msgid "Please restart the application after this window closed"
msgstr "Пожалуйста, перезапустите приложение после закрытия этого окна"

#: data/resources/ui/message_item.ui:175
msgid "Reply"
msgstr "Ответить"

#: data/resources/ui/message_item.ui:181
msgid "React"
msgstr "Отреагировать"

#: data/resources/ui/window.ui:108
msgid "About"
msgstr "О Приложении"

#: src/backend/channel.rs:296
msgid "Note to self"
msgstr "Заметка для себя"

#: src/backend/manager.rs:163
msgid "You"
msgstr "Вы"

#: src/error.rs:74
msgid "I/O Error."
msgstr "Ошибка I/O"

#: src/error.rs:79
msgid "There does not seem to be a connection to the internet available."
msgstr "Кажется нет подключения к Интернету."

#: src/error.rs:84
msgid "The communication with Libsecret failed."
msgstr "Связь с Libsecret не удалась."

#: src/error.rs:89
msgid ""
"The backend database failed. Please restart the application or delete the "
"database and relink the application."
msgstr ""
"Сбой внутренней базы данных. Пожалуйста, перезапустите приложение или "
"удалите базу данных и повторно свяжите приложение."

#: src/error.rs:94
msgid ""
"You do not seem to be authorized with Signal. Please delete the database and "
"relink the application."
msgstr ""
"Похоже вы не авторизованы в Signal. Пожалуйста, удалите базу данных и "
"повторно свяжите приложение."

#: src/error.rs:99
msgid "Sending a message failed."
msgstr "Отправка сообщения не удалась."

#: src/error.rs:104
msgid "Receiving a message failed."
msgstr "Получение сообщения не удалась."

#: src/error.rs:109
msgid ""
"Something unexpected happened with the signal backend. Please retry later."
msgstr ""
"Что-то неожиданное произошло с бэкендом signal. Пожалуйста, повторите "
"попытку позже."

#: src/error.rs:114
msgid "The application seems to be misconfigured."
msgstr "Кажется приложение неправильно настроено."

#: src/error.rs:124
msgid "Please check your internet connection."
msgstr "Пожалуйста, проверьте подключение к интернету."

#: src/error.rs:128
msgid "Please delete the database and relink the device."
msgstr "Пожалуйста, удалите базу данных и повторно привяжите устройство."

#: src/error.rs:135
msgid "The database path at {} is no folder."
msgstr "Путь к базе данных в {} не является папкой."

