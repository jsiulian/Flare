msgstr "Algo relacionado a glib falló."

#: src/error.rs:102
msgid "The communication with Libsecret failed."
msgstr "La comunicación con Libsecret falló."

#: src/error.rs:107
msgid ""
"The backend database failed. Please restart the application or delete the "
"database and relink the application."
msgstr ""
"La base de datos backend falló. Por favor reinicia la aplicación o borra la "
"base de datos y vincula de nuevo la aplicación."

#: src/error.rs:112
msgid ""
"You do not seem to be authorized with Signal. Please delete the database and "
"relink the application."
msgstr ""
"Parece que no está autorizado con Signal. Por favor, borre la base de datos "
"y vuelva a vincular la aplicación."

#: src/error.rs:117
msgid "Sending a message failed."
msgstr "Envío de mensaje fallido."

#: src/error.rs:122
msgid "Receiving a message failed."
msgstr "Recepción de mensaje fallido."

#: src/error.rs:127
msgid ""
"Something unexpected happened with the signal backend. Please retry later."
msgstr ""
"Sucedió algo inesperado con el backend de Signal. Por favor inténtalo "
"después."

#: src/error.rs:132
msgid "The application seems to be misconfigured."
msgstr "Parece que la aplicación está mal configurada."

#: src/error.rs:137
msgid "A part of the application crashed."
msgstr "Una parte de la aplicación se ha bloqueado."

#: src/error.rs:147
msgid "Please check your internet connection."
msgstr "Por favor revise su conexión a internet."

#: src/error.rs:152
msgid "Please delete the database and relink the device."
msgstr "Por favor borre la base de datos y vincule de nuevo el dispositivo."

#: src/error.rs:159
msgid "The database path at {} is no folder."
msgstr "La ruta de la base de datos en {} no es una carpeta."

#: src/error.rs:164
msgid "Please restart the application with logging and report this issue."
msgstr ""
"Por favor, reinicie la aplicación con el registro e informe de este problema."

